# FitVision staging/production settings. Copy to .env.production (git-ignored) and fill in.
# The API refuses to start if any required value is missing or unsafe.

# or: staging (same safety checks, separate database/bucket/secrets)
APP_ENV=production
SITE_ADDRESS=fitvision.example.com

# PostgreSQL (docker-compose service). Use a long random password.
POSTGRES_USER=fitvision
POSTGRES_DB=fitvision
POSTGRES_PASSWORD=

# Session signing key: at least 32 random characters, e.g. `openssl rand -base64 48`.
# Rotating it signs everyone out.
JWT_SECRET=
BCRYPT_ROUNDS=12

# Private object storage (S3, Cloudflare R2, or S3-compatible). The bucket must NOT be public.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com ; AWS: leave empty
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# optional, e.g. production/
S3_KEY_PREFIX=
S3_FORCE_PATH_STYLE=false

# Virtual try-on. Production must choose explicitly. The mock shows clearly labelled placeholder
# images; it only runs in production with TRYON_ALLOW_MOCK=true.
TRYON_PROVIDER=mock
TRYON_ALLOW_MOCK=true
# TRYON_PROVIDER=replicate
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL_VERSION=
# REPLICATE_COST_USD=
# Only after the provider passed the evaluation in docs/VALIDATION_TRACKING.md:
TRYON_PROVIDER_VERIFIED=false
# Avatar try-on (avatar render as the person image). Separate sign-off: VALIDATION_TRACKING.md §3b.
TRYON_AVATAR_VERIFIED=false
TRYON_DAILY_LIMIT=20
TRYON_MAX_ACTIVE=2

# Observability. /api/metrics is disabled unless a token is set (and is blocked at the edge).
METRICS_TOKEN=
LOG_LEVEL=info
