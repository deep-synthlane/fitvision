# Edge for FitVision: automatic HTTPS (Let's Encrypt), static web app, API reverse proxy.
# SITE_ADDRESS is the public hostname, e.g. fitvision.example.com (must match WEB_ORIGIN).
{$SITE_ADDRESS} {
	encode zstd gzip
	import /etc/caddy/security-headers.caddy

	# Uploads are limited again by the API; this is the outer bound.
	request_body {
		max_size 60MB
	}

	handle /api/* {
		# Metrics are for the internal network only.
		@metrics path /api/metrics
		respond @metrics 404
		reverse_proxy api:4000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
