# Copy to .env for local development. Everything is optional in development.
# Staging/production settings: see deploy/env.production.example and docs/DEPLOYMENT.md.
PORT=4000
# development | test | staging | production. staging/production refuse unsafe defaults.
# APP_ENV=development

# Database: unset → embedded PGlite in .data/pglite. Production requires PostgreSQL.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitvision

# Session signing key (>= 32 chars). Required in staging/production.
# JWT_SECRET=
# BCRYPT_ROUNDS=12               # must be >= 12 in staging/production
# AUTH_RATE_LIMIT_MAX=10         # login/register attempts per IP per 15 min
WEB_ORIGIN=http://localhost:5173

# Private storage for uploaded images. local (dev) or s3 (required in staging/production).
# STORAGE_DRIVER=local
# STORAGE_DIR=.data/uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=                   # R2 / MinIO endpoint; empty for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=
# S3_FORCE_PATH_STYLE=false      # true for MinIO

# Product import (dev/testing only): extra host:port pairs the importer may reach.
# IMPORT_ALLOW_HOSTS=127.0.0.1:4599

# Virtual try-on. Default is the mock provider (clearly labelled, not AI).
# TRYON_PROVIDER=mock            # or "replicate" (UNVERIFIED adapter; needs the two values below)
# TRYON_ALLOW_MOCK=false         # staging/production only run the mock when this is true
# TRYON_PROVIDER_VERIFIED=false  # set only after the evaluation in docs/VALIDATION_TRACKING.md
# TRYON_AVATAR_VERIFIED=false    # avatar renders as input; set only after a real model is seen dressing the avatar
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL_VERSION=
# REPLICATE_COST_USD=0.05        # per generation, for budgeting
# TRYON_TIMEOUT_MS=180000
# TRYON_POLL_MS=2000
# TRYON_DAILY_LIMIT=20           # per user per UTC day
# TRYON_MAX_ACTIVE=2             # per user
# TRYON_FAILED_RETENTION_DAYS=7

# Background jobs: inline (API runs them), api (queue only), worker (set by `pnpm worker`).
# JOB_MODE=inline
# WORKER_POLL_MS=2000

# Observability
# METRICS_TOKEN=                 # >= 16 chars; enables GET /api/metrics with a bearer token
# LOG_LEVEL=debug
