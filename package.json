{
  "name": "fitvision",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @fitvision/api --filter @fitvision/web dev",
    "dev:api": "pnpm --filter @fitvision/api dev",
    "dev:web": "pnpm --filter @fitvision/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm --filter @fitvision/web build && pnpm --filter @fitvision/api build",
    "db:generate": "pnpm --filter @fitvision/api db:generate",
    "calibration:report": "pnpm --filter @fitvision/calibration report",
    "calibration:fetch": "pnpm --filter @fitvision/calibration fetch-scan",
    "e2e": "pnpm --filter @fitvision/e2e e2e",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "seed": "pnpm --filter @fitvision/api seed"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.7.0"
}
