# Copy to tools/vton-eval/.env (git-ignored). Used only by the evaluation harness, never by the app.
REPLICATE_API_TOKEN=
# IDM-VTON (cuuupid/idm-vton), latest version as of 2026-11-11. Licence: CC BY-NC-SA 4.0 —
# technical evaluation only, NOT for production use.
REPLICATE_MODEL_VERSION=0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
# Estimate shown before billing data is fetched (Replicate quotes ~$0.024/run on A100 80GB).
REPLICATE_COST_USD=0.024
# A100 (80GB) per-second price used to turn billed predict_time into actual cost.
REPLICATE_PRICE_PER_SECOND=0.0014
